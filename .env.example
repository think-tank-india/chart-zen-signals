# NIFTY50 Trading Platform Environment Configuration

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=development
APP_PORT=8080
API_PORT=3001

# ===========================================
# FRONTEND SETTINGS
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME="NIFTY50 Trader Pro"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://nifty50_user:password@localhost:5432/nifty50_trader

# Redis connection string (for caching and sessions)
REDIS_URL=redis://localhost:6379

# ===========================================
# EXTERNAL DATA PROVIDERS
# ===========================================
# Zerodha MCP client URL (for real market data)
ZERODHA_MCP_URL=http://localhost:8080

# Alpha Vantage API (backup data source)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Yahoo Finance API (fallback)
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key_here

# ===========================================
# FEATURE FLAGS
# ===========================================
# Current development phase: MVP | ENHANCED | ADVANCED
ENABLE_PHASE=MVP

# Feature toggles
ENABLE_PORTFOLIO=false
ENABLE_EMAIL_ALERTS=false
ENABLE_SMS_ALERTS=false
ENABLE_BACKTESTING=false
ENABLE_PATTERN_RECOGNITION=false
ENABLE_ML_SIGNALS=false

# ===========================================
# NOTIFICATION SERVICES
# ===========================================
# Email service configuration
MAIL_PROVIDER=Resend
RESEND_API_KEY=your_resend_api_key_here

# Alternative: AWS SES
AWS_SES_ACCESS_KEY=your_aws_access_key
AWS_SES_SECRET_KEY=your_aws_secret_key
AWS_SES_REGION=us-east-1

# SMS service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# AUTHENTICATION
# ===========================================
AUTH_STRATEGY=EmailMagicLink
JWT_SECRET=your_super_secret_jwt_key_here
MAGIC_LINK_SECRET=your_magic_link_secret_here

# ===========================================
# TRADING CONFIGURATION
# ===========================================
# Target index for analysis
TARGET_INDEX=NIFTY50

# Default timeframes for analysis
DEFAULT_TIMEFRAMES=1m,5m,15m,1h,1d

# Technical indicator settings
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20
BOLLINGER_DEVIATION=2

# Signal generation settings
SIGNAL_CONFIDENCE_THRESHOLD=70
SIGNAL_STRENGTH_MIN=3
MAX_SIGNALS_PER_DAY=50

# ===========================================
# RISK MANAGEMENT
# ===========================================
DEFAULT_RISK_PERCENTAGE=2
MAX_RISK_PERCENTAGE=5
DEFAULT_RISK_REWARD_RATIO=2
STOP_LOSS_BUFFER=0.5

# ===========================================
# MONITORING & LOGGING
# ===========================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true

# Sentry (error tracking)
SENTRY_DSN=your_sentry_dsn_here

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id_here

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Mock data settings (for development)
ENABLE_MOCK_DATA=true
MOCK_VOLATILITY=0.002
MOCK_UPDATE_INTERVAL=5000

# Hot reload and development tools
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_MODE=true

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
# Rate limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
HELMET_ENABLED=true
CORS_ENABLED=true

# ===========================================
# BACKUP & MAINTENANCE
# ===========================================
# Database backup settings
DB_BACKUP_ENABLED=false
DB_BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
DB_BACKUP_RETENTION_DAYS=30

# Market data archival
ARCHIVE_DATA_OLDER_THAN_DAYS=365